{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Game (Clang)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/linux_clang/bin/profile/NameOfYourProject.GameLauncher",
            "cwd":"${fileDirname}"
        },
        {
            "name": "Editor (Clang)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/linux_clang/bin/profile/Editor",
            "cwd":"${fileDirname}",
            
            /// This is a fix for Arch-Linux. Use only if the Editor-UI has strange dimensions
            "env": {
                "QT_AUTO_SCREEN_SCALE_FACTOR": "0",
                "QT_ENABLE_HIGHDPI_SCALING": "1",
                "QT_FONT_DPI": "96"
            }
        },
        {
            "name": "NameOfYourGem Tests (Clang)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/linux_clang/bin/profile/AzTestRunner",
            "args": [
                "${workspaceFolder}/build/linux_clang/bin/profile/NameOfYourGem.Tests.so",
                "AzRunUnitTests"
            ],
            "console": "integratedTerminal",
        },
        {
            "name": "Material Editor (Clang)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/linux_clang/bin/profile/MaterialEditor",
            "cwd":"${fileDirname}",
            
            "env": {
                "QT_AUTO_SCREEN_SCALE_FACTOR": "0",
                "QT_ENABLE_HIGHDPI_SCALING": "1",
                "QT_FONT_DPI": "96"
            }
        },
        {
            "name": "Material Canvas (Clang)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/linux_clang/bin/profile/MaterialCanvas",
            "cwd":"${fileDirname}",
            
            "env": {
                "QT_AUTO_SCREEN_SCALE_FACTOR": "0",
                "QT_ENABLE_HIGHDPI_SCALING": "1",
                "QT_FONT_DPI": "96"
            }
        },
        {
